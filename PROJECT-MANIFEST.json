{
  "name": "cf-hono-price-monitor",
  "version": "1.6.1",
  "apps": {
    "api": "Hono + Cloudflare Workers + D1 + Drizzle + Queue + Cron",
    "web": "Vue 3 + TypeScript + Vite + Element Plus"
  },
  "deployment": "single Cloudflare Worker with Static Assets",
  "database": "price-monitor-db",
  "queue": "price-monitor-checks",
  "cron": [
    "* * * * *"
  ],
  "features": [
    "CRUD management",
    "batch SKU mapping",
    "table multi-select bulk rule assignment",
    "rule presets",
    "configurable daily price-check schedule",
    "IANA timezone support",
    "Queue/Cron price checks",
    "notifications",
    "10-second frontend status polling",
    "structured Cron tick/result logs",
    "local scheduled-event testing",
    "fixed local D1 persistence path"
  ]
}
