{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "price-monitor-db",
      "database_id": "51947776-3aeb-4020-9d95-0035b32483e2",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "PRICE_CHECK_QUEUE", "queue": "price-monitor-checks" }
    ],
    "consumers": [
      {
        "queue": "price-monitor-checks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  }
}
