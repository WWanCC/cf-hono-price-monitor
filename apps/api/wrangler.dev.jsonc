// 本地开发配置：保留 D1/Cron/Queue 结构，但不把前端 dist 作为 Worker 资源。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "price-monitor-db",
      "database_id": "51947776-3aeb-4020-9d95-0035b32483e2",
      "migrations_dir": "drizzle"
    }
  ],
  // 本地 Cron 仍保留与生产相同的时间配置，便于验证调度行为。
  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 7 * * *",
      "0 13 * * *"
    ]
  },
  // 本地 Queue 由 Wrangler/Miniflare 模拟，消息仍走同一个 consumer。
  "queues": {
    "producers": [
      {
        "binding": "PRICE_CHECK_QUEUE",
        "queue": "price-monitor-checks"
      }
    ],
    "consumers": [
      {
        "queue": "price-monitor-checks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "max_concurrency": 1
      }
    ]
  }
}
