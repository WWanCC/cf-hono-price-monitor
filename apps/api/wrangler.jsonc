{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "price-monitor",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "price-monitor-db",
			"database_id": "51947776-3aeb-4020-9d95-0035b32483e2",

			"migrations_dir": "drizzle"
		}
	],

	"secrets": {
		"required": [
			"MIAOMIAO_TOKEN"
		]
	}

